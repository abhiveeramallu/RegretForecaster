# AI provider options:
# AI_PROVIDER=ollama | openai-compatible | anthropic
# Default behavior if unset:
# - uses Anthropic when ANTHROPIC_API_KEY is present
# - otherwise uses OpenAI-compatible when AI_API_KEY + AI_BASE_URL are present
# - otherwise falls back to local Ollama
AI_PROVIDER=ollama
AI_MODEL=llama3.2:latest
AI_BASE_URL=
AI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
